<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>Hello BittorrentClient!</title>
    <link rel="stylesheet" href="<%= static_path(@conn, "/assets/app.css") %>">
  </head>

  <body>
    <div class="container">
      <header class="header">
        <nav role="navigation">
          <ul class="nav nav-pills pull-right">
            <li><a href="http://www.phoenixframework.org/docs">Get Started</a></li>
          </ul>
        </nav>
        <span class="logo"></span>
      </header>

      <p class="alert alert-info" role="alert"><%= Phoenix.Flash.get(assigns[:flash] || %{}, :info) %></p>
      <p class="alert alert-danger" role="alert"><%= Phoenix.Flash.get(assigns[:flash] || %{}, :error) %></p>

      <main role="main">
        <%= @inner_content %>
      </main>

    </div> <!-- /container -->
    <script src="<%= static_path(@conn, "/assets/app.js") %>"></script>
  </body>
</html>
